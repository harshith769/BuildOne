# Copy to infra/compose/.env (never commit). Production values live only on the server (mode 600).
ENVIRONMENT=local                      # local | production
ROOT_DOMAIN=localhost
APP_ORIGIN=http://localhost:5173
LEGAL_TIMEZONE=Asia/Kolkata

# --- Postgres (roles created by infra/postgres/initdb) ---
POSTGRES_PASSWORD=change-me-superuser
APP_OWNER_PASSWORD=change-me
APP_API_PASSWORD=change-me
APP_WORKER_PASSWORD=change-me
APP_INGEST_PASSWORD=change-me
APP_READONLY_PASSWORD=change-me
DATABASE_URL_API=postgresql+psycopg://app_api:change-me@postgres:5432/buildone
DATABASE_URL_WORKER=postgresql+psycopg://app_worker:change-me@postgres:5432/buildone
DATABASE_URL_OWNER=postgresql+psycopg://app_owner:change-me@postgres:5432/buildone

# --- Identity ---
IDENTITY_PROVIDER=fake                 # fake | workos
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:8000/v1/auth/callback
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# --- Object storage (S3 API: MinIO locally, R2 in production) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_BUCKET_FILES=buildone-files-dev
S3_BUCKET_SOURCES=buildone-sources

# --- Backups (production only; write-only R2 token) ---
WALG_S3_PREFIX=
WALG_AWS_ACCESS_KEY_ID=
WALG_AWS_SECRET_ACCESS_KEY=
WALG_AWS_ENDPOINT=

# --- AI (see docs/ai-system.md) ---
GROQ_API_KEY=
GROQ_ZDR_ENABLED=false                 # must be true before any user_data task runs
GEMINI_API_KEY=                        # public_only tasks (rule drafting)
AI_BUDGET_SAFETY_FACTOR=0.8
COPILOT_DAILY_QUOTA_PER_ORG=10
CLAUSE_EXTRACT_DAILY_QUOTA_PER_ORG=3

# --- Embeddings (fixed by spike S2) ---
EMBEDDING_MODEL_ID=
EMBEDDING_DIM=

# --- Email (optional channel) ---
EMAIL_PROVIDER=none                    # none | <provider chosen in M8>
EMAIL_API_KEY=
EMAIL_FROM=

# --- Observability ---
SENTRY_DSN=
